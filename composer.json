{
    "name": "jundayw/message-pack-codec",
    "description": "MessagePack Codec, Built for PHP.",
    "keywords": [
        "php",
        "binary codec",
        "encoder",
        "decoder",
        "binary",
        "message-pack-codec"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/jundayw/message-pack-codec",
    "authors": [
        {
            "name": "jundayw",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "code-lts/doctum": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Jundayw\\MessagePackCodec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs": "@php vendor/bin/doctum.php update doctum.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
